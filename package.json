{
  "name": "lift-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Gym workout plan, tracker and notes app. Builds to a single self-contained HTML file.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node build.mjs && node tests/e2e/run.mjs",
    "check": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
